generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Client {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String?
  theme     String   @default("light")
  createdAt DateTime @default(now())
  
  projects  Project[]
}

model Project {
  id        String   @id @default(cuid())
  clientId  String
  name      String
  createdAt DateTime @default(now())

  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  botConfig BotConfig?
  leads               Lead[]
  campaigns           Campaign[]
  unansweredQuestions UnansweredQuestion[]
}

model BotConfig {
  id               String  @id @default(cuid())
  projectId        String  @unique
  identity         String?
  instructions     String?
  knowledgeData    String?
  knowledgeRaw     String?
  faq              String?
  leadScoringRules String? // Reglas de puntuación en texto natural
  
  // WhatsApp Configuration
  whatsappToken      String?
  whatsappPhoneId    String?
  whatsappBusinessId String?
  
  project          Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Lead {
  id        String   @id @default(cuid())
  projectId String
  phone     String
  name      String?
  status    String   @default("PENDING")
  score     Int      @default(0) // Puntuación de interés del cliente
  heat      String   @default("FRIO") // FRIO, TIBIO, CALIENTE
  aiSummary String?  // Resumen IA de la conversación, se actualiza automáticamente
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  latestCampaignId String?

  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  latestCampaign Campaign? @relation(fields: [latestCampaignId], references: [id], onDelete: SetNull)
  chat           Chat?
}

model Chat {
  id           String   @id @default(cuid())
  leadId       String   @unique
  botActive    Boolean  @default(true)
  isArchived   Boolean  @default(false)
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())

  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  messages     Message[]
}

model Message {
  id        String   @id @default(cuid())
  chatId    String
  role      String
  content   String
  createdAt DateTime @default(now())

  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

model Campaign {
  id              String   @id @default(cuid())
  projectId       String
  name            String
  status          String   @default("DRAFT")
  leadCount       Int      @default(0)
  csvData         String?
  templateName    String?  // nombre de la template aprobada en Meta
  variableMapping String?  // JSON: { "1": "nombre", "2": "empresa" } etc.
  createdAt       DateTime @default(now())

  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  leadsGenerated Lead[]
}

model UnansweredQuestion {
  id        String   @id @default(cuid())
  projectId String
  question  String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
