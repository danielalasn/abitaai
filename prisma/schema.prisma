generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Client {
  id                 String             @id @default(cuid())
  name               String
  email              String             @unique
  createdAt          DateTime           @default(now())
  password           String?
  theme              String             @default("light")
  role               String             @default("CLIENT")
  templateGroup      String?
  subscriptionEndsAt DateTime?
  subscriptionStatus SubscriptionStatus @default(ACTIVE)
  messageLimit       Int?               @default(1000)
  subscriptionResetDay Int              @default(1)
  failedLoginAttempts Int               @default(0)
  avatarUrl          String?
  auditLogs          AuditLog[]
  integrations       Integration[]
  projects           Project[]
  pushSubscriptions  PushSubscription[]
}

model Integration {
  id                 String    @id @default(cuid())
  clientId           String
  provider           String
  status             String    @default("pending")
  oauthState         String?
  accessToken        String?
  tokenExpiresAt     DateTime?
  pageId             String?
  instagramAccountId String?
  businessId         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  client             Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, provider])
}

model Project {
  id                  String               @id @default(cuid())
  clientId            String
  name                String
  createdAt           DateTime             @default(now())
  whatsappBusinessId  String?
  whatsappPhoneId     String?
  whatsappToken       String?
  defaultBotActive    Boolean              @default(false)
  leadScoringEnabled  Boolean              @default(true)
  notificationEmails      String[]             @default([])
  notificationPhones      String[]             @default([])
  handoffTemplateStatus   String?
  botAutoWakeHours        Float?               @default(168)
  agents              Agent[]
  botConfig           BotConfig?
  botTestSuites       BotTestSuite[]
  calendarConfig      CalendarConfig?
  sheetsConfig        SheetsConfig?
  campaigns           Campaign[]
  leads               Lead[]
  nangoConnections    NangoConnection[]
  client              Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  unansweredQuestions UnansweredQuestion[]
  userBookings        UserBooking[]
  botFiles            BotFile[]
}

model BotConfig {
  id                 String  @id @default(cuid())
  projectId          String  @unique
  identity           String?
  instructions       String?
  knowledgeData      String?
  knowledgeRaw       String?
  faq                String?
  leadScoringRules   String?
  whatsappToken      String?
  whatsappPhoneId    String?
  whatsappBusinessId String?
  handoffRules       String?
  project            Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Lead {
  id               String    @id @default(cuid())
  projectId        String
  phone            String
  name             String?
  status           String    @default("PENDING")
  score            Int       @default(0)
  heat             String    @default("FRIO")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  aiSummary        String?
  latestCampaignId String?
  agentId          String?
  metadata         Json?     @default("{}")
  channel          String    @default("whatsapp")
  email            String?
  chat             Chat?
  agent            Agent?    @relation(fields: [agentId], references: [id])
  latestCampaign   Campaign? @relation(fields: [latestCampaignId], references: [id])
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([phone, projectId])
}

model Chat {
  id           String    @id @default(cuid())
  leadId       String    @unique
  botActive    Boolean   @default(true)
  lastActiveAt DateTime  @default(now())
  createdAt    DateTime  @default(now())
  isArchived   Boolean   @default(false)
  channel      String    @default("whatsapp")
  autoWakeBot  Boolean   @default(true)
  disabledDueToLimit Boolean @default(false)
  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  messages     Message[]
}

model Message {
  id            String   @id @default(cuid())
  chatId        String
  role          String
  content       String
  createdAt     DateTime @default(now())
  inputTokens   Int?
  outputTokens  Int?
  waCategory    String?
  agentName     String?
  scoreBump     Int?
  scoreReason   String?
  imageUrl      String?
  status        String   @default("SENT")
  wamid         String?  @unique
  mediaFilename String?
  mediaType     String?
  mediaUrl      String?
  sendError     String?
  buttonsConfig String?
  chat          Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

model Campaign {
  id               String        @id @default(cuid())
  projectId        String
  name             String
  status           String        @default("DRAFT")
  leadCount        Int           @default(0)
  csvData          String?
  templateName     String?
  variableMapping  String?
  createdAt        DateTime      @default(now())
  agentId          String?
  templateCategory String?
  languageCode     String        @default("es")
  agent            Agent?        @relation(fields: [agentId], references: [id])
  project          Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  logs             CampaignLog[]
  leadsGenerated   Lead[]
}

model CampaignLog {
  id         String   @id @default(cuid())
  campaignId String
  phone      String
  status     String   @default("SENT")
  error      String?
  createdAt  DateTime @default(now())
  wamid      String?  @unique
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model UnansweredQuestion {
  id        String   @id @default(cuid())
  projectId String
  question  String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  botAnswer String?
  agentId   String?
  agent     Agent?   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Agent {
  id                  String               @id @default(cuid())
  projectId           String
  name                String               @default("Agente Principal")
  description         String?
  isActive            Boolean              @default(true)
  identity            String?
  instructions        String?
  knowledgeData       String?
  knowledgeRaw        String?
  faq                 String?
  leadScoringRules    String?
  handoffRules        String?
  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  campaigns           Campaign[]
  leads               Lead[]
  unansweredQuestions UnansweredQuestion[]
}

model PromptBlock {
  id          String   @id @default(cuid())
  order       Int
  key         String   @unique
  label       String
  description String?
  xmlTag      String
  content     String   @default("")
  source      String
  agentField  String?
  isEnabled   Boolean  @default(true)
  isDeletable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WebhookEvent {
  id        String   @id
  provider  String
  payload   Json
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  clientId  String?
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}

model BotTestSuite {
  id                 String   @id @default(cuid())
  projectId          String
  totalConversations Int
  averageScore       Float?
  criticalIssues     Int?
  status             String
  resultsRaw         String?
  suggestedPrompt    String?
  createdAt          DateTime @default(now())
  progress           String?
  project            Project  @relation(fields: [projectId], references: [id])
}

model NangoConnection {
  id                String   @id @default(cuid())
  projectId         String
  providerConfigKey String
  connectionId      String
  status            String   @default("CONNECTED")
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, providerConfigKey])
  @@index([projectId])
}

model CalendarConfig {
  id                  String   @id @default(cuid())
  projectId           String   @unique
  fieldsToCollect     String[] @default([])
  eventTitle          String   @default("Cita / Reserva - {{nombre_cliente}}")
  eventDescription    String   @default("Cliente: {{nombre_cliente}}\nAgendado via Abita AI.")
  durationMinutes     Int      @default(60)
  confirmationMessage String   @default("¡Listo! Su cita ha sido agendada para el {{fecha}} a las {{hora_inicio}}.")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  selectedCalendarIds String[] @default([])
  maxCapacityPerSlot  Int      @default(1)
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model SheetsConfig {
  id        String   @id @default(cuid())
  projectId String   @unique
  tables    Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model UserBooking {
  id        String   @id @default(cuid())
  phone     String
  projectId String
  eventId   String
  date      String
  startTime String
  endTime   String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([phone, projectId])
}

model BotFile {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String
  url         String
  filename    String?
  mimeType    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model PushSubscription {
  id        String   @id @default(cuid())
  clientId  String
  endpoint          String   @unique
  p256dh            String
  auth              String
  notifyHandoffs    Boolean  @default(true)
  notifyAllMessages Boolean  @default(false)
  createdAt         DateTime @default(now())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}
