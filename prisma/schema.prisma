generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Client {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String?
  theme     String   @default("light")
  createdAt DateTime @default(now())
  
  projects  Project[]
}

model Project {
  id        String   @id @default(cuid())
  clientId  String
  name      String
  createdAt DateTime @default(now())

  // WhatsApp Configuration (migrado desde BotConfig)
  whatsappToken      String?
  whatsappPhoneId    String?
  whatsappBusinessId String?

  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  botConfig BotConfig?
  agents    Agent[]
  leads               Lead[]
  campaigns           Campaign[]
  unansweredQuestions UnansweredQuestion[]
}

model BotConfig {
  id               String  @id @default(cuid())
  projectId        String  @unique
  identity         String?
  instructions     String?
  knowledgeData    String?
  knowledgeRaw     String?
  faq              String?
  leadScoringRules String? // Reglas de puntuación en texto natural
  
  // WhatsApp Configuration
  whatsappToken      String?
  whatsappPhoneId    String?
  whatsappBusinessId String?
  
  project          Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Lead {
  id        String   @id @default(cuid())
  projectId String
  agentId   String?
  phone     String
  name      String?
  status    String   @default("PENDING")
  score     Int      @default(0) // Puntuación de interés del cliente
  heat      String   @default("FRIO") // FRIO, TIBIO, CALIENTE
  aiSummary String?  // Resumen IA de la conversación, se actualiza automáticamente
  metadata  Json?    @default("{}") // Información extra del CRM / Campañas
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  latestCampaignId String?

  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agent          Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
  latestCampaign Campaign? @relation(fields: [latestCampaignId], references: [id], onDelete: SetNull)
  chat           Chat?
}

model Chat {
  id           String   @id @default(cuid())
  leadId       String   @unique
  botActive    Boolean  @default(true)
  isArchived   Boolean  @default(false)
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())

  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  messages     Message[]
}

model Message {
  id           String   @id @default(cuid())
  chatId       String
  role         String
  content      String
  inputTokens  Int?     // Tokens de entrada (prompt + historia)
  outputTokens Int?     // Tokens de salida (la respuesta generada)
  waCategory   String?  // Categoría de WhatsApp: MARKETING, UTILITY, SERVICE, etc.
  agentName    String?  // Nombre del agente que respondió (para auditoría/simulador)
  scoreBump    Int?     // Puntos sumados/restados en este mensaje
  scoreReason  String?  // Razón de la calificación (ej: "Preguntó por precios")
  createdAt    DateTime @default(now())

  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

model Campaign {
  id              String   @id @default(cuid())
  projectId       String
  agentId         String?
  name            String
  status          String   @default("DRAFT")
  leadCount       Int      @default(0)
  csvData         String?
  templateName    String?  // nombre de la template aprobada en Meta
  variableMapping String?  // JSON: { "1": "nombre", "2": "empresa" } etc.
  createdAt       DateTime @default(now())

  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agent          Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)
  leadsGenerated Lead[]
}

model UnansweredQuestion {
  id        String   @id @default(cuid())
  projectId String
  agentId   String?
  question  String
  botAnswer String?
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agent     Agent?   @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model Agent {
  id               String  @id @default(cuid())
  projectId        String  
  name             String  @default("Agente Principal")
  description      String? 
  isActive         Boolean @default(true)
  
  identity         String?
  instructions     String?
  knowledgeData    String?
  knowledgeRaw     String?
  faq              String?
  leadScoringRules String?
  
  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  leads               Lead[]
  campaigns           Campaign[]
  unansweredQuestions UnansweredQuestion[]
}
