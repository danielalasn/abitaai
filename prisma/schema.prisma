generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model Client {
  id                 String             @id @default(cuid())
  name               String
  email              String             @unique
  password           String?
  theme              String             @default("light")
  role               String             @default("CLIENT") // Enum: ADMIN o CLIENT
  templateGroup      String?            // Prefijo para filtrar plantillas de Meta
  subscriptionStatus SubscriptionStatus @default(ACTIVE)
  subscriptionEndsAt DateTime?          // null means lifetime/unlimited for now, or you can set a date
  createdAt          DateTime           @default(now())
  
  projects     Project[]
  integrations Integration[]
}

model Integration {
  id                 String    @id @default(cuid())
  clientId           String
  provider           String    // "meta_instagram"
  status             String    @default("pending") // pending | active | error | disconnected
  oauthState         String?   // CSRF token temporal
  accessToken        String?
  tokenExpiresAt     DateTime?
  pageId             String?
  instagramAccountId String?
  businessId         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, provider])
}

model Project {
  id        String   @id @default(cuid())
  clientId  String
  name      String
  createdAt DateTime @default(now())

  // WhatsApp Configuration (migrado desde BotConfig)
  whatsappToken      String?
  whatsappPhoneId    String?
  whatsappBusinessId String?
  
  // Opción general para deshabilitar el bot por defecto para nuevos leads
  defaultBotActive   Boolean  @default(true)

  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  botConfig BotConfig?
  agents    Agent[]
  leads               Lead[]
  campaigns           Campaign[]
  unansweredQuestions UnansweredQuestion[]
}

model BotConfig {
  id               String  @id @default(cuid())
  projectId        String  @unique
  identity         String?
  instructions     String?
  knowledgeData    String?
  knowledgeRaw     String?
  faq              String?
  leadScoringRules String? // Reglas de puntuación en texto natural
  
  // WhatsApp Configuration
  whatsappToken      String?
  whatsappPhoneId    String?
  whatsappBusinessId String?
  
  project          Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Lead {
  id        String   @id @default(cuid())
  projectId String
  agentId   String?
  phone     String
  channel   String   @default("whatsapp") // "whatsapp" | "instagram"
  name      String?
  status    String   @default("PENDING")
  score     Int      @default(0) // Puntuación de interés del cliente
  heat      String   @default("FRIO") // FRIO, TIBIO, CALIENTE
  aiSummary String?  // Resumen IA de la conversación, se actualiza automáticamente
  metadata  Json?    @default("{}") // Información extra del CRM / Campañas
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  latestCampaignId String?

  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agent          Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
  latestCampaign Campaign? @relation(fields: [latestCampaignId], references: [id], onDelete: SetNull)
  chat           Chat?

  @@unique([phone, projectId])
}

model Chat {
  id           String   @id @default(cuid())
  leadId       String   @unique
  channel      String   @default("whatsapp") // "whatsapp" | "instagram"
  botActive    Boolean  @default(true)
  isArchived   Boolean  @default(false)
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())

  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  messages     Message[]
}

model Message {
  id           String   @id @default(cuid())
  chatId       String
  role         String
  content      String
  inputTokens  Int?     // Tokens de entrada (prompt + historia)
  outputTokens Int?     // Tokens de salida (la respuesta generada)
  waCategory   String?  // Categoría de WhatsApp: MARKETING, UTILITY, SERVICE, etc.
  wamid        String?  @unique // ID devuelto por Meta para rastreo de estado
  status       String   @default("SENT") // SENT, DELIVERED, READ, FAILED
  agentName    String?  // Nombre del agente que respondió (para auditoría/simulador)
  scoreBump    Int?     // Puntos sumados/restados en este mensaje
  scoreReason  String?  // Razón de la calificación (ej: "Preguntó por precios")
  imageUrl     String?  // URL de imagen adjunta (ej: de una campaña)
  mediaUrl     String?  // URL de cualquier archivo adjunto
  mediaFilename String? // Nombre original del archivo
  mediaType    String?  // image, document, video, audio
  createdAt    DateTime @default(now())

  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

model Campaign {
  id              String   @id @default(cuid())
  projectId       String
  agentId         String?
  name            String
  status          String   @default("DRAFT")
  leadCount       Int      @default(0)
  csvData         String?
  templateName    String?  // nombre de la template aprobada en Meta
  templateCategory String?  // MARKETING o UTILITY
  variableMapping String?  // JSON: { "1": "nombre", "2": "empresa" } etc.
  createdAt       DateTime @default(now())

  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agent          Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)
  leadsGenerated Lead[]
  logs           CampaignLog[]
}

model CampaignLog {
  id         String   @id @default(cuid())
  campaignId String
  wamid      String?  @unique // ID devuelto por Meta para rastreo
  phone      String
  status     String   @default("SENT") // SENT, FAILED, DELIVERED, READ
  error      String?
  createdAt  DateTime @default(now())

  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model UnansweredQuestion {
  id        String   @id @default(cuid())
  projectId String
  agentId   String?
  question  String
  botAnswer String?
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agent     Agent?   @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model Agent {
  id               String  @id @default(cuid())
  projectId        String  
  name             String  @default("Agente Principal")
  description      String? 
  isActive         Boolean @default(true)
  
  identity         String?
  instructions     String?
  knowledgeData    String?
  knowledgeRaw     String?
  faq              String?
  leadScoringRules String?
  
  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  leads               Lead[]
  campaigns           Campaign[]
  unansweredQuestions UnansweredQuestion[]
}

model SystemConfig {
  id               String   @id @default("default")
  globalGuardrails String?  
  namingRules      String?
  businessRules    String?
  pricingRules     String?
  handoffRules     String?
  visualRules      String?
  learningRules    String?
  scoringBaseRules String?
  updatedAt        DateTime @updatedAt
}
